{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": true,
  "globRoot": ".",
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    "js/**",
    "icons/**",
    "css/**",
    "*.min.js",
    "*.min.css",
    "composer.lock",
